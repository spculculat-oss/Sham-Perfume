{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && node --import tsx scripts/product-pages.mts dist && node --import tsx scripts/seo-build.mts dist",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.app.json",
    "build:pages": "vite build --mode pages && node scripts/prepare-pages.mjs && node --import tsx scripts/product-pages.mts pages-dist && node --import tsx scripts/seo-build.mts pages-dist",
    "test": "node --import tsx --import ./tests/register-assets.mjs --test tests/*.test.ts",
    "check:pages": "node scripts/check-pages.mjs",
    "build:vercel": "npm run build && node scripts/build-vercel.mjs",
    "test:vercel": "node --test tests/vercel-output.test.mjs",
    "check:edgeone": "node scripts/check-edgeone.mjs",
    "verify:keys": "node --import tsx scripts/verify-ai-keys.mts",
    "sync:vercel-env": "node scripts/sync-vercel-env.mjs",
    "seo:build": "node --import tsx scripts/seo-build.mts dist",
    "seo:run": "node --import tsx scripts/seo-agent/run.mts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "8.0.11",
    "postgres": "^3.4.7",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": "22.x"
  }
}
