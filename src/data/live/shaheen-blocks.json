       "action": "self_study",
       "id": "b2.1"
      },
      {
       "kind": "action",
       "label": "مذاكرة الباقي مع محرك متاح",
       "action": "study_ai",
       "id": "b2.2"
      }
     ]
    },
    {
     "kind": "action",
     "label": "التدريب العملي على مسائل حقيقية ونتائج موثقة",
     "action": "practice",
     "id": "b3"
    },
    {
     "kind": "action",
     "label": "حفظ الدروس في ذاكرة شاهين",
     "action": "remember",
     "id": "b4"
    },
    {
     "kind": "action",
     "label": "كتابة تقرير المدرسة",
     "action": "report",
     "id": "b5"
    }
   ]
  },
  {
   "id": "site-care",
   "title": "برنامج صيانة الموقع بالبلوكات",
   "goal": "فحص وصيانة الموقع يومياً قبل الذروة",
   "schedule": "daily 08:00",
   "runner": "patrol",
   "createdAt": "2026-10-31T08:59:50.376Z",
   "blocks": [
    {
     "kind": "note",
     "label": "صيانة وقائية يومية",
     "note": "تبدأ قبل ذروة الزوار وتُسجَّل نتائجها في التقرير.",
     "id": "b1"
    },
    {
     "kind": "action",
     "label": "فحص صحة الصفحات الأساسية",
     "action": "check_site",
     "id": "b2"
    },
    {
     "kind": "condition",
     "label": "لو الموقع شغال",
     "when": {
      "fact": "siteUp",
      "equals": true
     },
     "id": "b3",
     "children": [
      {
       "kind": "action",
       "label": "فحص الروابط المكسورة",
       "action": "check_links",
       "id": "b3.1"
      },
      {
       "kind": "action",
       "label": "فحص الصور",
       "action": "check_images",
       "id": "b3.2"
      },
      {
       "kind": "action",
       "label": "فحص شهادة الأمان",
       "action": "check_ssl",
       "id": "b3.3"
      },
      {
       "kind": "loop",
       "label": "فحص ثلاث عينات من صفحات المنتجات",
       "repeat": 3,
       "id": "b3.4",
       "children": [
        {
         "kind": "action",
         "label": "فحص عينة صفحة",
         "action": "check_page_sample",
         "id": "b3.4.1"
        }
       ]
      }
     ]
    },
    {
     "kind": "condition",
     "label": "لو الموقع وقع",
     "when": {
      "fact": "siteUp",
      "equals": false
     },
     "id": "b4",
     "children": [
      {
       "kind": "action",
       "label": "بلاغ صيانة عاجل",
       "action": "alert",
       "id": "b4.1"
      }
     ]
    },
    {
     "kind": "action",
     "label": "نسخة احتياطية",
     "action": "backup",
     "id": "b5"
    },
    {
     "kind": "action",
     "label": "تقرير الصيانة",
     "action": "report",
     "id": "b6"
    }
   ]
  },
