# Server-only secrets. Copy to .env for local development; never commit .env.
# Never prefix provider keys with VITE_ (Vite exposes those to the browser).
# GitHub Pages cannot run server.ts or use these keys.
GEMINI_API_KEY=""
DEEPSEEK_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Node hosting providers may supply their own PORT.
PORT=3000

# Use NODE_ENV=production when serving the built dist/ with npm start.
# APP_URL is optional metadata for hosting environments that provide it.
APP_URL=""

# Optional server-only model IDs. Use a model your provider account supports.
# The UI credits the provider that actually answered, not an assumed model version.
GEMINI_MODEL="gemini-2.5-flash"
DEEPSEEK_MODEL="deepseek-chat"
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_MODEL="claude-sonnet-4-5"

# ---------------- Sham Core (services assistant + admin) ----------------
# Admin dashboard at /#admin. 12+ characters; leave empty to keep admin disabled.
SHAM_ADMIN_TOKEN=""
# Storage: file (Node/VPS, default) | firestore (Vercel/Firebase) | memory (non-persistent)
SHAM_STORE=""
SHAM_DATA_FILE=".data/sham-core.json"
# Firestore service account (only when SHAM_STORE=firestore). Keep \n escapes in the key.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
SHAM_FIRESTORE_PREFIX="sham_core_"
# Optional self-hosted open model (Ollama, vLLM, LM Studio...). OpenAI-compatible /v1 base URL.
SHAM_LLM_BASE_URL=""
SHAM_LLM_MODEL="qwen2.5:7b-instruct"
SHAM_LLM_API_KEY=""
# Optional OpenRouter: one key, many hosted models (handy for advisory-council seats from different vendors).
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
# Advisory council answers per client per hour (each one costs several model calls).
SHAM_COUNCIL_RATE_PER_HOUR=12
# Demo catalog for previews only (products are labelled as demo).
SHAM_SEED_DEMO="false"
SHAM_CHAT_RATE_PER_MIN=20
# Sites allowed to call this API from another origin (the static GitHub Pages build).
# Comma separated exact origins; default https://spculculat-oss.github.io ; "none" disables.
SHAM_CORS_ORIGINS=""
# Build-time only, for the static Pages build: the deployed API it should call (https).
# In CI this comes from the PAGES_API_BASE_URL repository variable. Never set it on Vercel.
VITE_API_BASE_URL=""
# Number of trusted proxy hops for client IPs (Vercel defaults to 1).
SHAM_TRUST_PROXY=""
# Optional signed webhook for new requests, human handoffs and negative ratings
# (Slack/Discord incoming webhook, n8n, Make, Zapier → WhatsApp/Telegram/e-mail). https only.
SHAM_WEBHOOK_URL=""
# If set, every call carries X-Sham-Signature: sha256=HMAC_SHA256(secret, raw body).
SHAM_WEBHOOK_SECRET=""
