# Server-only secrets. Copy to .env for local development; never commit .env.
# Never prefix provider keys with VITE_ (Vite exposes those to the browser).
# GitHub Pages cannot run server.ts or use these keys.
GEMINI_API_KEY=""
DEEPSEEK_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Node hosting providers may supply their own PORT.
PORT=3000

# Use NODE_ENV=production when serving the built dist/ with npm start.
# APP_URL is optional metadata for hosting environments that provide it.
APP_URL=""

# Optional server-only model IDs. Use a model your provider account supports.
# The UI credits the provider that actually answered, not an assumed model version.
GEMINI_MODEL="gemini-flash-latest"
DEEPSEEK_MODEL="deepseek-chat"
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_MODEL="claude-sonnet-4-5"

# ---------------- Sham Core (services assistant + admin) ----------------
# Admin dashboard at /#admin. 12+ characters; leave empty to keep admin disabled.
SHAM_ADMIN_TOKEN=""
# Storage: file (Node/VPS, default) | firestore (Vercel/Firebase) | memory (non-persistent)
SHAM_STORE=""
SHAM_DATA_FILE=".data/sham-core.json"
# Firestore service account (only when SHAM_STORE=firestore). Keep \n escapes in the key.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
SHAM_FIRESTORE_PREFIX="sham_core_"
# Optional self-hosted open model (Ollama, vLLM, LM Studio...). OpenAI-compatible /v1 base URL.
SHAM_LLM_BASE_URL=""
SHAM_LLM_MODEL="qwen2.5:7b-instruct"
SHAM_LLM_API_KEY=""
# Tencent EdgeOne Makers model gateway (OpenAI-compatible, free monthly tokens for built-in models).
# Used by the same engine when SHAM_LLM_BASE_URL is empty; default model @makers/deepseek-v4-flash
# (override with SHAM_LLM_MODEL, e.g. @makers/hy3). See EDGEONE.md.
AI_GATEWAY_API_KEY=""
# Optional OpenRouter: one key, many hosted models (handy for advisory-council seats from different vendors).
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
# Advisory council answers per client per hour (each one costs several model calls).
SHAM_COUNCIL_RATE_PER_HOUR=12
# Demo catalog for previews only (products are labelled as demo).
SHAM_SEED_DEMO="false"
SHAM_CHAT_RATE_PER_MIN=20
# «الخبير شاهين» (perfume-design chat on both sites): messages per visitor per minute.
# Engines, order, models, tone, length and extra instructions live in server/config/shaheen.ts
# (shared baseline for Vercel + GitHub Pages) and can be overridden from Admin → «الخبير شاهين».
SHAM_SHAHEEN_RATE_PER_MIN=10
# Shaheen's visual aids (GET /api/media): images come from Wikimedia Commons (no key needed).
# Videos use the YouTube Data API v3: YOUTUBE_API_KEY, or else GEMINI_API_KEY if YouTube Data API v3
# is enabled in that same Google Cloud project. Without either, visitors get a YouTube search link.
YOUTUBE_API_KEY=""
SHAM_MEDIA_RATE_PER_MIN=40
# Sites allowed to call this API from another origin (the static GitHub Pages build).
# Comma separated exact origins; default https://spculculat-oss.github.io ; "none" disables.
SHAM_CORS_ORIGINS=""
# Build-time only, for the static Pages build: the deployed API it should call (https).
# In CI this comes from the PAGES_API_BASE_URL repository variable. Never set it on Vercel.
VITE_API_BASE_URL=""
# Number of trusted proxy hops for client IPs (Vercel defaults to 1).
SHAM_TRUST_PROXY=""
# Optional signed webhook for new requests, human handoffs and negative ratings
# (Slack/Discord incoming webhook, n8n, Make, Zapier → WhatsApp/Telegram/e-mail). https only.
SHAM_WEBHOOK_URL=""
# If set, every call carries X-Sham-Signature: sha256=HMAC_SHA256(secret, raw body).
SHAM_WEBHOOK_SECRET=""

# ---------------- «منارة شاهين» (SEO & media agent) ----------------
# Canonical public origin used in sitemap.xml, robots.txt, canonicals and IndexNow submissions.
# Defaults to https://sham-perfume-49bf.vercel.app/
SEO_SITE_URL=""
# Submit changed URLs to search engines from scripts/seo-agent/run.mts (1/true). Off in local dev.
SEO_SUBMIT=""
# Comma-separated engine order for the scheduled agent; unconfigured engines are skipped.
SEO_ENGINE_ORDER="gemini,deepseek,openai,claude,openrouter,self_hosted"
# Google Search Console (optional, free): service-account JSON with Search Console API access + the exact property.
# It is NOT required: sitemap.xml + feed.xml (both declared in robots.txt) and the WebSub ping carry discovery.
# No card is needed for Search Console itself; a Cloud service account is only for automating the console API.
GSC_SERVICE_ACCOUNT_JSON=""
GSC_SITE_URL=""
# Optional WebSub hubs for the RSS feed (comma-separated). Empty = the public defaults in src/seo/discovery.ts.
WEBSUB_HUBS=""
# Bing Webmaster API (optional): URL submission for Bing immediately (IndexNow already covers the rest).
BING_WEBMASTER_API_KEY=""
# Search-engine verification files generated into the build (optional).
# The site's own Google token is already committed in public/google7ef3d5aa6cf98197.html; set this
# only to verify a DIFFERENT property (another host) with a second token.
GOOGLE_SITE_VERIFICATION=""
# Bing Webmaster auth token (goes into BingSiteAuth.xml). Optional.
BING_SITE_VERIFICATION=""

# ---------------- «أمين شاهين» (private finance / hosted payments) ----------------
# Live payments require a durable SHAM_STORE and an approved registration in Admin → Finance.
# No key or bank data is accepted by the browser form. Test payments never fulfil real orders.
KASHIER_MERCHANT_ID=""
KASHIER_API_KEY=""
KASHIER_SECRET_KEY=""
KASHIER_MODE="test"
KASHIER_CURRENCIES="EGP"
# HTTPS API origin (not the GitHub Pages storefront). Used for the authenticated provider callback.
SHAM_PUBLIC_API_URL=""
SHAM_FINANCE_TIMEZONE="Africa/Cairo"
# Scheduler only: repository variable pointing at the deployed API; uses secret SHAM_ADMIN_TOKEN.
SHAM_FINANCE_API_URL=""
