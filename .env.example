# Server-only secrets. Copy to .env for local development; never commit .env.
# Never prefix provider keys with VITE_ (Vite exposes those to the browser).
# GitHub Pages cannot run server.ts or use these keys.
GEMINI_API_KEY=""
DEEPSEEK_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Node hosting providers may supply their own PORT.
PORT=3000

# Use NODE_ENV=production when serving the built dist/ with npm start.
# APP_URL is optional metadata for hosting environments that provide it.
APP_URL=""

# Optional server-only model IDs. Use a model your provider account supports.
# The UI credits the provider that actually answered, not an assumed model version.
GEMINI_MODEL="gemini-2.5-flash"
DEEPSEEK_MODEL="deepseek-chat"
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_MODEL="claude-sonnet-4-5"
