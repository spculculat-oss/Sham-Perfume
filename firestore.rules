rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'name', 'craftLevel', 'regionId'])
        && data.id is string
        && data.email is string
        && data.name is string && data.name.size() <= 100
        && data.craftLevel is string
        && data.regionId is string;
    }

    // User accounts collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if isOwner(userId);

      // Formulas subcollection
      match /formulas/{formulaId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(formulaId);
        allow delete: if isOwner(userId);
      }

      // Chats subcollection
      match /chats/{chatId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(chatId);
        allow delete: if isOwner(userId);
      }
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
    }
  }
}
